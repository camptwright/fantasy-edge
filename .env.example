# Copy to .env and fill in. Never commit .env.

# ---- postgres ----
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=            # openssl rand -hex 24
POSTGRES_DB=fantasy_edge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- the odds api ----
# Free tier is 500 requests/MONTH. The scheduler is season-aware and the client
# refuses to poll once x-requests-remaining drops below the floor.
ODDS_API_KEY=
ODDS_API_QUOTA_FLOOR=50

# ---- shared Adjutant/LiteLLM gateway (parlay generation) ----
# CT110's gateway owns the provider fallback:
# gaming-PC Hermes/Ollama -> Mac mini Ollama -> cloud.
LITELLM_BASE_URL=http://192.168.8.200:4000/v1
LITELLM_API_KEY=
FANTASY_MODEL_ALIAS=worker

# ---- alerts ----
DISCORD_WEBHOOK_URL=

# ---- optional historical data ----
CFBD_API_KEY=

# ---- polling cadence (seconds) ----
POLL_INTERVAL_IN_SEASON=300
POLL_INTERVAL_OFF_SEASON=21600
PROPS_POLL_INTERVAL=300

# ---- modelling ----
MODEL_DIR=/mnt/data/fantasy-edge/models
KELLY_FRACTION=0.25
LOG_LEVEL=INFO
ENVIRONMENT=production
