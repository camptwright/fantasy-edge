# Copy to .env and fill in. Never commit .env.

# ---- postgres ----
POSTGRES_USER=fantasy
POSTGRES_PASSWORD=            # openssl rand -hex 24
POSTGRES_DB=fantasy_edge
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# ---- the odds api ----
# Free tier is 500 requests/MONTH. The scheduler is season-aware and the client
# refuses to poll once x-requests-remaining drops below the floor.
ODDS_API_KEY=
ODDS_API_QUOTA_FLOOR=50

# ---- app-owned LiteLLM gateway (parlay generation) ----
# reekserver-1 cannot reach the LAN Ollama backend (different subnet, no
# route) - this sidecar calls Anthropic directly instead, same as every
# other app on that host.
LITELLM_BASE_URL=http://litellm:4000/v1
LITELLM_API_KEY=
FANTASY_MODEL_ALIAS=worker
ANTHROPIC_API_KEY=
ADJUTANT_API_URL=
ADJUTANT_API_TOKEN=
# Routed through reekserver-1's shared Cloudflare Tunnel (id
# af0c35fc-ec30-407e-8f9c-56c76e4e8e22, also serving OpenWebUI) - no
# per-app tunnel or token needed. Connect the `cloudflared` container to
# this project's compose network, then add Public Hostname routes in the
# Zero Trust dashboard for the api and dashboard containers.

# ---- alerts ----
DISCORD_WEBHOOK_URL=
# Self-hosted ntfy (see the ntfy project, not ntfy.sh) - canary/anomaly
# alerts for scraper breakage and gap detection. Leave all three blank to
# log alerts only (src/utils/alerts.py never raises just because ntfy isn't
# configured, but that also means a real failure - e.g. Sleeper sync
# crashing on every scheduled run, found live 2026-09-05 - goes completely
# unnoticed until someone happens to check the logs).
#
# On reekserver-1: point at that host's shared ntfy behind its existing
# Cloudflare Tunnel, e.g. https://ntfy.camptwright.com - no per-app ntfy
# container needed there.
#
# On a standalone deployment with no shared tunnel (this Mac mini's local
# stack): docker-compose.yml defines its own `ntfy` service instead. Use
# NTFY_BASE_URL=http://ntfy:80 (the container's internal address - workers
# publish over the compose network, the host-published port is only for a
# phone to subscribe from). See DEPLOYMENT.md's "ntfy alerting" section for
# the one-time `ntfy user add`/`ntfy access`/`ntfy token add` setup this
# needs before anything can publish or subscribe (fresh installs default to
# deny-all).
NTFY_BASE_URL=
NTFY_TOPIC=fantasy-edge-alerts
NTFY_TOKEN=

# ---- optional historical data ----
CFBD_API_KEY=

# ---- polling cadence (seconds) ----
POLL_INTERVAL_IN_SEASON=300
POLL_INTERVAL_OFF_SEASON=21600
PROPS_POLL_INTERVAL=300

# ---- modelling ----
MODEL_DIR=/mnt/data/fantasy-edge/models
KELLY_FRACTION=0.25
LOG_LEVEL=INFO
ENVIRONMENT=production

# ---- Sleeper multi-league sync ----
SLEEPER_USERNAME=papareek
# Optional: licensed weekly NFL projections. SportsDataIO's endpoint is used
# only when a key is present; without it the app remains on Sleeper fallback.
SPORTSDATAIO_API_KEY=
# Override only for an approved compatible provider endpoint.
SPORTSDATAIO_PROJECTION_BASE_URL=https://api.sportsdata.io/v3/nfl/projections/json
# Required for Fantasy data APIs; generate with `openssl rand -hex 32`.
FANTASY_API_TOKEN=
CF_ACCESS_TEAM_DOMAIN=your-team.cloudflareaccess.com
CF_ACCESS_AUD=
# Comma-separated, HTTPS RSS feeds you explicitly approve for current news.
FANTASY_NEWS_RSS_URLS=https://www.espn.com/espn/rss/nfl/news,https://sports.yahoo.com/nfl/rss,https://www.nytimes.com/athletic/rss/nfl/,https://www.cbssports.com/rss/headlines/nfl/,https://www.sbnation.com/rss/nfl/index.xml,https://www.fantasypros.com/feed/,https://www.reddit.com/r/fantasyfootball/.rss,https://www.reddit.com/r/DynastyFF/.rss
